PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000
# USER_AGENT defaults to MCP-Legal-Chile/<package.json version> if unset.
# USER_AGENT=MCP-Legal-Chile/1.13.0 (https://mcp-legal-chile.onrender.com)
# WEB_SEARCH_USER_AGENT=…  # browser-like UA for Yahoo SERP
# BOT_USER_AGENT=…         # polite bot UA for DuckDuckGo HTML/lite (separate from WEB_SEARCH_USER_AGENT)
# LOG_LEVEL=info        # debug | info | warn | error
# LOG_FORMAT=json        # json (structured, auto-on when RENDER is set) | text (default locally)
# CACHE_MAX_ENTRIES=2000 # LRU cap per in-memory cache tier
# CONTACT_EMAIL=you@example.com   # polite pool OpenAlex/Crossref (mailto=)
FETCH_TIMEOUT_MS=12000
TC_TIMEOUT_MS=18000
SEARCH_TOOL_TIMEOUT_MS=22000
JURIS_WEB_BUDGET_MS=6500
WEB_SEARCH_TIMEOUT_MS=5000
SPARQL_TIMEOUT_MS=10000
PACK_TOTAL_MS=18000
PACK_TIMEOUT_MS=11000
WARMUP_ON_BOOT=1
# RATE_LIMIT_PER_MINUTE=60
# HTTP_REQUEST_TIMEOUT_MS=60000
# HTTP_HEADERS_TIMEOUT_MS=65000
# HTTP_KEEPALIVE_TIMEOUT_MS=61000
# Optional self-host only (not required; open access by default):
# REDIS_URL=redis://...
# MCP_API_KEYS=demo:replace-me:200
# LEYCHILE_MIN_INTERVAL_MS=1000
# LEYCHILE_429_CACHE_MS=60000
# MAX_RETRY_AFTER_MS=30000
# CIRCUIT_OPEN_MS=90000
# CIRCUIT_THRESHOLD=3
# UNIFIED_BUDGET_MS=8000

# --- pjudCauses (buscar_causa_pjud / obtener_causa_pjud) ---
# EXPERIMENTAL / NO OFICIAL: usa Playwright + un solver de pago para eludir el
# CAPTCHA anti-bot (F5/TSPD) de la Oficina Judicial Virtual de PJUD. Riesgo de
# ToS asumido explícitamente por quien habilite esta función. Ver
# docs/pjud-casetracking-solution.md. Deshabilitado por defecto (kill switch).
# PJUD_CAUSAS_ENABLED=1
# CAPTCHA_SOLVER_PROVIDER=2captcha   # 2captcha | capsolver
# CAPTCHA_SOLVER_API_KEY=replace-me
# CAPTCHA_SOLVE_TIMEOUT_MS=120000
# PJUD_SESSION_TTL_MS=1500000        # 25 min: reutiliza cookie de sesión validada
# PJUD_CAUSAS_DAILY_SOLVE_BUDGET=50  # tope diario de CAPTCHAs resueltos (control de costo)
# PJUD_CAUSAS_CACHE_TTL_MS=21600000  # 6h: TTL de cache de resultados de causas
# PJUD_CAUSAS_CACHE_STALE_MS=86400000 # 24h: máximo stale-while-revalidate
